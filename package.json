{
  "name": "kalshi-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "observable preview",
    "build": "observable build",
    "briefing:generate": "node scripts/generate-daily-briefing.mjs",
    "test:data-loader": "node --test tests/remote-data.test.mjs",
    "test:data-watchdog": "python3 -m unittest tests.test_freshness_remote",
    "test:data-transport": "npm run test:data-loader && npm run test:data-watchdog",
    "clean": "rm -rf dist"
  },
  "type": "module",
  "dependencies": {
    "@observablehq/framework": "1.13.4"
  }
}
